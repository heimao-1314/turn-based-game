# ============================================
# dw-pocket-spirit — Git 忽略规则（AI 友好）
# ============================================

# ---- 依赖 ----
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnpm-store/

# ---- 运行时数据库（禁止入库，含玩家数据）----
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-journal
players-db.json

# ---- 环境与密钥 ----
.env
.env.*
!.env.example
config.local.*
secrets/
admin-secrets.bat

# ---- 日志 / 临时运行输出 ----
logs/
*.log
_stderr.txt
_stdout.txt
_codex_server_*.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---- 构建 / 缓存 / 临时 ----
dist/
dist-public/
build/
.cache/
tmp/
temp/
*.tmp
*.temp
output/

# ---- 备份 ----
*.bak
*.backup
*.old
*.orig
_backup_*/

# ---- 实验 / 外部工具（非核心玩法源码）----
bandwidth-optimizer/
.playwright-cli/

# ---- 上线打包（本仓库不维护打包链路）----
上线打包模块/
**/game-service.exe
