# 复制为 .env 后按需修改（.env 不会入库）
# NODE_ENV=production 时，下列管理员相关项必须设为非默认强口令

PORT=6588
NODE_ENV=development

# 本机管理口令
ADMIN_PASSWORD=change-me-admin

# 远程管理员
REMOTE_ADMIN_ACCOUNT=change-me-remote-admin
REMOTE_ADMIN_PASSWORD=change-me-remote-password

# 游戏/地图管理员
GAME_ADMIN_ACCOUNT=change-me-map-admin
GAME_ADMIN_PASSWORD=change-me-map-password

# 可选：把数据库放到站点目录外
# PLAYER_DB_PATH=D:/game-data/players.sqlite

# 可选：WebSocket
# WS_IDLE_CLOSE_MS=90000
# WS_BANDWIDTH_STATS=0

# 实验带宽优化（默认关闭）
# ENABLE_BW_OPT=0
# DISABLE_BW_OPT=1
